[{"ch": 1, "idx": 0, "pali": "Namo tassa bhagavato arahato sammāsambuddhassa", "zh": "礼敬那位跋葛瓦，阿拉汉，正自觉者！（三遍）", "head": 0.0}, {"ch": 1, "idx": 1, "pali": "Sammajjanī, padīpo ca, udakaṃ āsanena ca, uposathassa (pavāraṇāya) etāni ‘pubbakaraṇan’ti vuccati.", "zh": "扫帚以及灯，水以及座位，这些称为伍波思特（邀请）的“事前任务”。", "head": 0.13}, {"ch": 1, "idx": 2, "pali": "Iti aṭṭhakathācariyehi vuttattā.", "zh": "这是诸义註师所说。", "head": 0.15}, {"ch": 1, "idx": 3, "pali": "Sammajjana-karaṇaṃ niṭṭhitaṃ.", "zh": "扫地的任务已完成。", "head": 0.12}, {"ch": 1, "idx": 35, "pali": "Sādhu! Sādhu! Sādhu!", "zh": "萨度！萨度！萨度！", "head": 0.24}, {"ch": 1, "idx": 4, "pali": "Padīpujjalanaṃ niṭṭhitaṃ.", "zh": "（无阳光）灯已经点亮了。", "head": 0.0}, {"ch": 1, "idx": 6, "pali": "Āsanena saha pānīya-paribhojanīya-udakaṭṭhapanaṃ niṭṭhitaṃ.", "zh": "座位以及饮用、洗用之水都已经放置好了。", "head": 0.0}, {"ch": 1, "idx": 8, "pali": "‘Uposathassa uposathakammassa (pavāraṇāya pavāraṇākammassa) pubbakaraṇan’ti vuccati.", "zh": "故被称为伍波思特甘马（邀请甘马）的“事前任务”。", "head": 0.01}, {"ch": 1, "idx": 13, "pali": "Tasmā chanda-pārisuddhi (pavāraṇā)-āharaṇaṃ idha natthi.", "zh": "所以这里不用带来意欲、清净（邀请）。", "head": 0.0}, {"ch": 1, "idx": 14, "pali": "Chandāharaṇa pārisuddhi (pavāraṇā)-āharaṇāni pana imissaṃ sīmāyaṃ hatthapāsaṃ vijahitvā nisinnānaṃ bhikkhūnaṃ abhāvato natthi.", "zh": "（在大界、村界）不用带来意欲和带来清净（邀请），因为在此界内并没有坐在伸手所及处之外的比库。", "head": 0.01}, {"ch": 2, "idx": 36, "pali": "Suṇātu me bhante saṅgho", "zh": "尊者们，请僧团听我[说]，", "head": 0.14}, {"ch": 2, "idx": 37, "pali": "Ajjuposatho pannaraso", "zh": "今天是十五日伍波萨他。", "head": 0.14}, {"ch": 2, "idx": 38, "pali": "yadi saṅghassa pattakallaṃ", "zh": "如果僧团已到适时，", "head": 0.16}, {"ch": 2, "idx": 39, "pali": "saṅgho uposathaṃ kareyya", "zh": "僧团应举行伍波萨他，", "head": 0.14}, {"ch": 2, "idx": 79, "pali": "avivadamānehi sikkhitabbaṃ", "zh": "应被无争议者学修。", "head": 0.22}, {"ch": 2, "idx": 41, "pali": "Kiṃ saṅghassa pubbakiccaṃ", "zh": "什么是僧团的事前义务？", "head": 0.0}, {"ch": 2, "idx": 44, "pali": "taṃ sabbeva santā sādhukaṃ", "zh": "请一切在场者对此好好", "head": 0.0}, {"ch": 2, "idx": 47, "pali": "asantiyā āpattiyā tuṇhī bhavitabbaṃ", "zh": "没有罪者应当沉默。", "head": 0.0}, {"ch": 2, "idx": 51, "pali": "veyyākaraṇaṃ hoti", "zh": "有所回答。", "head": 0.02}, {"ch": 2, "idx": 52, "pali": "evamevaṃ evarūpāya parisāya", "zh": "同样地，在如此之众中", "head": 0.0}, {"ch": 3, "idx": 80, "pali": "Tatrime cattāro pārājikādhammā uddesaṃ āgacchanti", "zh": "于此，诵出此四巴拉基咖法来。", "head": 0.13}, {"ch": 3, "idx": 81, "pali": "Yo pana bhikkhu bhikkhūnaṃ sikkhā-sājīva-samāpanno", "zh": "若比库得到诸比库之学与生活规则，", "head": 0.15}, {"ch": 3, "idx": 82, "pali": "sikkhaṃ appaccakkhāya dubbalyaṃ anāvikatvā", "zh": "未舍弃学，没有表明羸弱", "head": 0.01}, {"ch": 3, "idx": 83, "pali": "methunaṃ dhammaṃ paṭiseveyya", "zh": "而从事淫欲法者，", "head": 0.0}, {"ch": 3, "idx": 135, "pali": "avivadamānehi sikkhitabbaṃ", "zh": "应被无争议者学修。", "head": 1.04}, {"ch": 3, "idx": 85, "pali": "pārājiko hoti asaṃvāso", "zh": "也是巴拉基咖，不共住。", "head": 0.01}, {"ch": 3, "idx": 93, "pali": "Yo pana bhikkhu sañcicca", "zh": "若比库故意", "head": 0.0}, {"ch": 3, "idx": 98, "pali": "ambho purisa kiṃ", "zh": "“喂，男子！为什么", "head": 0.0}, {"ch": 3, "idx": 104, "pali": "ayampi pārājiko hoti asaṃvāso", "zh": "这也是巴拉基咖，不共住。", "head": 0.0}, {"ch": 3, "idx": 105, "pali": "Yo pana bhikkhu anabhijānaṃ", "zh": "若比库声称未证知的", "head": 0.0}, {"ch": 4, "idx": 136, "pali": "Ime kho panāyasmanto", "zh": "具寿们，把这", "head": 0.14}, {"ch": 4, "idx": 137, "pali": "terasa saṅghādisesā dhammā uddesaṃ āgacchanti", "zh": "十三僧始终法来诵出。", "head": 0.12}, {"ch": 4, "idx": 138, "pali": "Sañcetanikā sukka-vissaṭṭhi", "zh": "故意出精，", "head": 0.01}, {"ch": 4, "idx": 139, "pali": "aññatra supinantā saṅghādiseso", "zh": "除了梦中外，僧始终。", "head": 0.14}, {"ch": 4, "idx": 352, "pali": "avivadamānehi sikkhitabbaṃ", "zh": "应被无争议者学修。", "head": 0.69}, {"ch": 4, "idx": 141, "pali": "vipariṇatena cittena", "zh": "以变易之心", "head": 0.01}, {"ch": 4, "idx": 145, "pali": "aññatarassa vā aññatarassa vā", "zh": "或对任何", "head": 0.0}, {"ch": 4, "idx": 150, "pali": "yathā taṃ yuvā yuvatiṃ", "zh": "犹如少男对少女[说]", "head": 0.01}, {"ch": 4, "idx": 156, "pali": "yā mādisaṃ sīlavantaṃ kalyāṇa-dhammaṃ brahma-cāriṃ", "zh": "像我这样的持戒者、善法者、梵行者，", "head": 0.0}, {"ch": 4, "idx": 160, "pali": "itthiyā vā purisa-matiṃ", "zh": "[传达]男子之意给女子，", "head": 0.01}]